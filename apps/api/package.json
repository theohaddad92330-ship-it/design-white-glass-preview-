{
  "name": "@bellum/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "./start.sh",
    "build": "[ -n \"$CI_TYPES_VERIFIES\" ] || node --max-old-space-size=6144 node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/check-types.tsbuildinfo",
    "check-types:tests": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/check-types-tests.tsbuildinfo",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "convert:commercial-brief": "ts-node --transpile-only src/scripts/commercial-brief/convert-brief-xlsx.ts",
    "convert:orange-dossier": "ts-node --transpile-only src/scripts/commercial-brief/convert-account-dossier.ts --account orange",
    "convert:account-dossier": "ts-node --transpile-only src/scripts/commercial-brief/convert-account-dossier.ts",
    "convert:market-brief": "ts-node --transpile-only src/scripts/market-brief/convert-market-brief-xlsx.ts",
    "ingest:dataforge": "ts-node --transpile-only src/scripts/ingest-dataforge.ts",
    "ingest:market-memory": "ts-node --transpile-only src/scripts/ingest-market-memory.ts",
    "measure:market-memory-cohort-index": "ts-node --transpile-only src/scripts/measure-market-memory-cohort-index.ts",
    "measure:techno-prevalence": "ts-node --transpile-only src/scripts/measure-techno-prevalence.ts",
    "ingest:orion-rag-chunks": "ts-node --transpile-only src/scripts/ingest-orion-rag-chunks.ts",
    "ingest:orion-accounts": "ts-node --transpile-only src/scripts/ingest-orion-accounts-master.ts",
    "ingest:orion-anomalies": "ts-node --transpile-only src/scripts/ingest-orion-anomalies.ts",
    "ingest:orion-needs": "ts-node --transpile-only src/scripts/ingest-orion-needs.ts",
    "ingest:market-v2": "ts-node --transpile-only src/scripts/ingest-market-v2.ts",
    "ingest:market-paths-v2": "ts-node --transpile-only src/scripts/ingest-market-paths-v2.ts",
    "ingest:common-account-links": "ts-node --transpile-only src/scripts/ingest-common-account-links.ts",
    "import:tout": "ts-node --transpile-only src/scripts/import-tout.ts",
    "roles:app-metadata": "ts-node --transpile-only src/scripts/roles-vers-app-metadata.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:next": "node scripts/prochain-horodatage-migration.mjs",
    "migration:run:prod": "node scripts/migrate-with-lock.mjs",
    "migration:show:prod": "typeorm migration:show -d dist/database/data-source.js",
    "migration:backup": "ts-node --transpile-only src/scripts/migration-backup.ts",
    "migration:restore": "ts-node --transpile-only src/scripts/migration-restore.ts",
    "migration:shadow-compare": "ts-node --transpile-only src/scripts/migration-shadow-compare-cli.ts"
  },
  "dependencies": {
    "@bellum/contracts": "workspace:*",
    "@bellum/email": "workspace:*",
    "@bellum/errors": "workspace:*",
    "@bellum/events": "workspace:*",
    "@bellum/http": "workspace:*",
    "@bellum/utils": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.18",
    "@reflag/node-sdk": "^1.8.2",
    "@sentry/nestjs": "^8.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/adm-zip": "^0.6.0",
    "adm-zip": "^0.6.1",
    "bullmq": "^5.73.0",
    "compression": "1.8.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.14.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "ioredis": "^5.10.1",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.5.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.7.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "stripe": "^17.7.0",
    "typeorm": "^0.3.28",
    "unzipper": "^0.12.5",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@bellum/tooling": "workspace:^",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.8",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.32.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "undici": "^8.12.2"
  }
}
