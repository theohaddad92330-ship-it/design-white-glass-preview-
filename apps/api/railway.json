{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "date -u +%Y-%m-%dT%H:%M:%SZ > apps/api/build-time.txt && NODE_OPTIONS=--max-old-space-size=6144 pnpm turbo build --filter=@bellum/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/package.json",
      "/turbo.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @bellum/api migration:run:prod",
    "startCommand": "pnpm --filter @bellum/api start",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "multiRegionConfig": {
      "europe-west4-drams3a": { "numReplicas": 2 }
    }
  }
}
