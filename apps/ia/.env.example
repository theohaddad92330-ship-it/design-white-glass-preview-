# BellumAI — IA service environment variables
#
# Copy to .env and fill in. Real secrets MUST NOT be committed.

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── External data sources ─────────────────────────────────────────────────────
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
PAPPERS_API_KEY=
# GitHub org tech signal (optional). Unauth works at 60 req/h; a token lifts the
# limit to 5000/h. BOAMP marchés publics IT (appels d'offres ouverts) et DECP
# marchés ATTRIBUÉS (qui a gagné quoi — titulaire = concurrent) sont GRATUITS,
# sans clé. France Travail (offres IT enrichies) reste sous OAuth2 (voir plus bas).
# Toutes ces sources no-op gracieusement si indisponibles.
GITHUB_TOKEN=

# IA v2 Data Gateway — providers de recherche web du waterfall (Serper → Tavily →
# Brave). Le gateway tourne toujours (phase/1/research) et ajoute des hits de
# recherche dédupliqués au bloc web des prompts. Providers optionnels : sans clé,
# le provider no-op (aucun appel réseau) et le gateway passe au suivant ; sans
# aucune clé, il n'ajoute rien. Brave réutilise BRAVE_API_KEY ci-dessus.
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Kill-switches d'urgence (break-glass — NE PAS poser en temps normal) ──────
# Les 4 axes IA v2 (judge anti-hallucination, LLM gateway, data gateway,
# grounding) sont ON PAR DÉFAUT, sans feature flag. Poser `=true` coupe UN axe
# en incident prod ; retirer la variable le réactive. Toute autre valeur
# (absent, vide, false, 0…) = axe actif. Voir app/services/kill_switch.py.
# JUDGE_DISABLED=true        # retire le node judge du graphe (lu au build ; restart pour le graphe module-level)
# LLM_GATEWAY_DISABLED=true  # ignore LLM_GATEWAY_ROUTING / LLM_ROUTE_* — direct Anthropic + modèle appelant (lu à chaque appel)
# DATA_GATEWAY_DISABLED=true # search() → [] sans réseau — plus de hits Serper/Tavily/Brave additionnels (lu à chaque appel)
# GROUNDING_DISABLED=true    # ground_facts_v2 → (None, None) sans appel Claude — plus de clé grounding/KPI (lu à chaque appel)

# ── Supabase (RAG + analyses persistence) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
