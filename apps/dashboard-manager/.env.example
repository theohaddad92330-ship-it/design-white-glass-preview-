# Base URL of the BellumAI API (local dev default below). Powers both the
# telemetry monitoring and the super-admin backoffice (/internal/admin/*).
API_BASE_URL=http://localhost:3012
# Must match the API's INTERNAL_API_SECRET — used as the x-internal-secret header
# on GET /internal/telemetry AND the backoffice /internal/admin/* endpoints
# (InternalSecretGuard, cross-tenant). Server-side only — never exposed to the
# browser (used in server components + route handlers). ⚠️ The backoffice can
# mutate any user/plan/ESN, so gate the deployed DM itself (Vercel password/SSO
# or basic-auth).
INTERNAL_API_SECRET=

# ── Premier rideau : Basic Auth (OBLIGATOIRE, fail closed) ───────────────────
# L'une des deux absente = TOUT rend 503. L'URL *.vercel.app de production n'est
# pas couverte par la protection gratuite de Vercel : sans ça, elle est publique.
DM_BASIC_AUTH_USER=
DM_BASIC_AUTH_PASSWORD=

# ── Second rideau : identité + TOTP + rôles (#1668, #1669) ───────────────────
# L'INTERRUPTEUR. ABSENTE = couche inerte, chemin byte-identique à avant (Basic
# Auth seul). POSÉE MAIS SANS AUCUNE ADRESSE = 503, jamais un accès ouvert.
# Rôles : owner (tout) · operator (tout sauf offres, factures, trésorerie,
# suppression) · viewer (lecture seule). Sans suffixe = operator.
# DM_ALLOWED_EMAILS=theo@bellum-it.com:owner,louis@bellum-it.com:operator
#
# Requises dès que DM_ALLOWED_EMAILS est posée : le back-office vérifie mot de
# passe et TOTP contre le MÊME Supabase que le produit, donc il ne garde aucun
# secret d'authentification. Serveur uniquement.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
#
# La fenêtre d'enrôlement TOTP : à poser le temps d'enrôler, puis à RETIRER.
# Retirée, plus personne ne peut s'auto-enrôler.
# DM_ENROLLMENT_OPEN=1

# Sentry (projet bellum-backoffice, UE). Vide = aucun envoi (dev/CI silencieux).
NEXT_PUBLIC_SENTRY_DSN=
