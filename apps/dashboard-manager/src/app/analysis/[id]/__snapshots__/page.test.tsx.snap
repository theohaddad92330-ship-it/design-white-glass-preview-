exports[`le détail d’une analyse rend la même chose avant et après le découpage > une analyse PARTIELLE — champs absents, identité incertaine, suivi live 1`] = `
"<main class="wrap"><a class="link" href="/">← retour</a><h1 style="margin-top:12px;display:flex;align-items:center;gap:10px">acc-partielle</h1><p class="subtitle"><span class="badge running">running</span></p><div class="card" style="border-color:var(--stop);padding:12px;margin:10px 0"><strong style="color:var(--stop)">⚠ Homonyme détecté — identité légale incertaine</strong><div style="font-size:12px;color:var(--muted);margin-top:4px">Mode <span class="badge STOP">groupe web</span> — les données registre (SIREN, effectif, secteur officiel) ne sont PAS utilisées dans l&#x27;en-tête ni le scoring. SIREN écarté : 999888777.</div><ul style="font-size:12px;margin:6px 0 0;padding-left:18px"><li>Deux sociétés portent ce nom</li><li>Aucun SIREN ne correspond au site web</li></ul></div><div style="margin-top:12px;padding:8px 12px;border-radius:8px;border:1px solid var(--border);color:var(--accent);font-size:13px">● Analyse en cours — suivi live (rafraîchissement auto · 0s). Les phases, APIs appelées et résultats apparaissent au fil de l&#x27;eau.</div><section class="kpi-grid"><div class="card"><div class="label">Secteur</div><div class="value" style="font-size:15px">—</div></div><div class="card"><div class="label">Effectif</div><div class="value" style="font-size:15px">—</div></div><div class="card"><div class="label">Confiance globale</div><div class="value" style="font-size:15px">—</div></div><div class="card"><div class="label">Filiales</div><div class="value" style="font-size:15px">1</div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Audit par phase — d&#x27;où viennent le coût, le temps et les infos</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><div class="card"><div class="label" style="margin-bottom:10px">Durée par phase</div><div style="display:grid;gap:8px"><p style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0">Graphique en barres, 1 valeur : research 12s</p><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">research</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:100%;height:100%;background:#7c6cf6;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">12s</span></div></div></div><div class="card"><div class="label" style="margin-bottom:10px">Coût par phase</div><div style="display:grid;gap:8px"><p style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0">Graphique en barres, 1 valeur : research $0.0200</p><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">research</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:2%;height:100%;background:#7c6cf6;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">$0.0200</span></div></div></div></div><table style="margin-top:12px"><thead><tr><th>Phase</th><th class="num">Coût</th><th class="num">Durée</th><th class="num">Tokens in / out</th><th>Sources</th></tr></thead><tbody><tr><td>research</td><td class="num">$0.0200</td><td class="num">12s</td><td class="num">2 000 / 300</td><td style="color:var(--muted);font-size:12px">—</td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Organigramme du groupe (2 entités)</h3><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><span style="font-weight:400">Cible Ambigüe</span><span style="color:var(--muted);font-size:12px"> · inconnu</span></li></ul><p style="margin:10px 0 0;font-size:12px;color:var(--muted)">🎯 = entité IT/digitale (cible n°1 ESN) · P1 attaque immédiate · P2 second temps · P3 longue traîne</p></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Organigramme des contacts (1)</h3><p style="margin:0 0 12px;font-size:12px;color:var(--muted)">Hiérarchie inférée des intitulés de poste (Apollo ne fournit pas les liens managériaux) — Direction → Management → Opérationnel, par entité.</p><div style="display:grid;gap:16px"><div><h4 style="margin:0 0 6px;font-size:13px;border-left:3px solid var(--border);padding-left:8px">Entité non précisée <span style="color:var(--muted);font-weight:400">· 1</span></h4><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">C-Level / COMEX (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Direction (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Management (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Expert / Senior (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Opérationnel (1)</div><div style="display:flex;align-items:center;gap:6px;margin:3px 0;flex-wrap:wrap"><span style="width:24px;height:24px;border-radius:50%;flex-shrink:0;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:var(--surface);color:var(--muted);font-size:13px;font-weight:600">—</span><span>—</span></div></li></ul></li></ul></li></ul></li></ul></li></ul></div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Contacts (1) — par entité</h3><p style="font-size:12px;margin:0 0 12px"><span style="color:var(--danger);font-weight:600">✗ aucun décideur IT (TECHNICAL)</span><span style="color:var(--muted)"> · 1 entité(s) · regroupés pour l’organigramme, triés par priorité</span></p><div style="display:grid;gap:18px"><div><h4 style="margin:0 0 8px;font-size:14px;border-left:3px solid var(--border);padding-left:8px">Entité non précisée <span style="color:var(--muted);font-weight:400">· 1</span></h4><div style="display:grid;gap:10px"><div class="card" style="padding:14px;border:1px solid var(--border);border-radius:10px"><div style="display:flex;justify-content:space-between;gap:8px"><div style="display:flex;align-items:center;gap:10px"><span style="width:38px;height:38px;border-radius:50%;flex-shrink:0;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:var(--surface);color:var(--muted);font-size:13px;font-weight:600">—</span><div><strong>—</strong></div></div><div style="white-space:nowrap"> <span class="badge RISQUE">RISQUE</span><span style="color:var(--accent);margin-left:6px"> · 12/100</span></div></div><div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;font-size:12px"></div></div></div></div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Grounding — provenance &amp; fiabilité (fait / hypothèse)</h3><details style="margin-top:12px"><summary style="cursor:pointer;color:var(--muted)">Sources consultées (1)</summary><ul style="margin-top:6px"><li><span style="color:var(--muted)">brave</span> — sans-titre</li></ul></details></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Entités / zones de chasse (2)</h3><table><tbody><tr><td></td><td>Cible Ambigüe</td><td style="color:var(--muted)">inconnu</td><td style="color:var(--muted)"></td><td></td></tr><tr><td></td><td>Cible Ambigüe</td><td style="color:var(--muted)">doublon</td><td style="color:var(--muted)"></td><td></td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Filiales opérationnelles (1)</h3><table><tbody><tr><td>Filiale Unique SARL</td><td class="num" style="color:var(--muted)"></td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Actualités — Brave News (1)</h3><ul><li>Une actualité sans lien</li></ul></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Plan d&#x27;action</h3><p style="color:var(--muted);font-size:13px">Plan non encore généré pour cette analyse.</p></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Sources consultées (1)</h3><table><tbody><tr><td><span class="pill">brave</span></td><td>sans-titre</td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Collecte — matière première fournie au modèle</h3><table><tbody><tr><td class="mono" style="width:240px;color:var(--muted)">Résultats Brave</td><td>4</td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Réponse brute (raw_analysis)</h3><details><summary style="cursor:pointer;color:var(--muted)">Afficher le JSON complet</summary><pre style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;overflow:auto;font-size:12px;margin-top:10px">{
  &quot;sector&quot;: &quot;&quot;,
  &quot;identity&quot;: {
    &quot;status&quot;: &quot;homonyme&quot;,
    &quot;reasons&quot;: [
      &quot;Deux sociétés portent ce nom&quot;,
      &quot;Aucun SIREN ne correspond au site web&quot;
    ],
    &quot;identityRejectedSiren&quot;: &quot;999888777&quot;
  },
  &quot;subsidiaries&quot;: [
    {
      &quot;name&quot;: &quot;Filiale Unique SARL&quot;
    }
  ],
  &quot;entities_exhaustive&quot;: [
    {
      &quot;name&quot;: &quot;Cible Ambigüe&quot;,
      &quot;type&quot;: &quot;inconnu&quot;,
      &quot;parent&quot;: &quot;Parent Absent&quot;
    },
    {
      &quot;name&quot;: &quot;Cible Ambigüe&quot;,
      &quot;type&quot;: &quot;doublon&quot;
    }
  ],
  &quot;programs&quot;: [],
  &quot;news&quot;: [
    {
      &quot;title&quot;: &quot;Une actualité sans lien&quot;
    }
  ],
  &quot;sources&quot;: {
    &quot;registry&quot;: [
      {
        &quot;provider&quot;: &quot;brave&quot;,
        &quot;ref&quot;: &quot;sans-titre&quot;
