exports[`le détail d’une analyse rend la même chose avant et après le découpage > le détail introuvable — la page rend son erreur, pas une page blanche 1`] = `"<main class="wrap"><a class="link" href="/">← retour</a><div class="error" style="margin-top:16px">Détail indisponible. Telemetry endpoint returned 404 Not Found</div></main>"`;

exports[`le détail d’une analyse rend la même chose avant et après le découpage > une analyse COMPLÈTE — toutes les sections du dossier 1`] = `
"<link rel="preload" as="image" href="https://exemple.test/logo.png" referrerPolicy="no-referrer"/><link rel="preload" as="image" href="https://exemple.test/photo1.jpg" referrerPolicy="no-referrer"/><main class="wrap"><a class="link" href="/">← retour</a><h1 style="margin-top:12px;display:flex;align-items:center;gap:10px"><img src="https://exemple.test/logo.png" alt="" width="28" height="28" style="border-radius:6px;object-fit:contain" referrerPolicy="no-referrer"/>Groupe Exemple</h1><p class="subtitle"><span class="badge completed">completed</span> · coût $0.4000 · priorité 8/10 · confiance 75/100 (élevée)<span class="badge P2"> plafonné qualité</span> · <span class="badge PUBLIC">GO 19/25</span> · <span class="badge P2" title="Deux plays sans preuve datée">qualité: a_corriger (1)</span> · <span class="badge PUBLIC" title="Positionnement complément, pas concurrence frontale.">complément (groupe Groupe Exemple)</span> · SIREN 552081317</p><div style="display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 0"><span style="font-size:12px;color:var(--muted);align-self:center">Fiabilité du dossier —</span><span class="badge GO" style="font-size:12px">Technique 88/100</span><span class="badge GO" style="font-size:12px">Identité 95/100</span><span class="badge GO" style="font-size:12px">Sources 74/100</span><span class="badge STOP" style="font-size:12px">Commerciale 39/100</span></div><p style="font-size:12px;color:var(--muted);margin:4px 0 0"><span>Trois entités IT autonomes, un plan de modernisation annoncé, un cycle d’achat court. </span><span>· fit offre 8 · accès 6 · urgence 7 · cycle 5</span></p><div style="margin-top:10px;font-size:12px"><span style="color:var(--muted)">Score /25 — pourquoi : </span><span style="margin-right:10px" title="TMA alignée">Fit offre <b>6</b>/8</span><span style="margin-right:10px" title="">Accès <b>5</b>/7</span></div><section class="kpi-grid"><div class="card"><div class="label">Secteur</div><div class="value" style="font-size:15px">Aéronautique &amp; défense</div></div><div class="card"><div class="label">Effectif</div><div class="value" style="font-size:15px">81 000</div></div><div class="card"><div class="label">Confiance globale</div><div class="value" style="font-size:15px">75/100 (élevée)<span class="badge P2" style="margin-left:6px">plafonné qualité</span></div><div style="font-size:11px;color:var(--muted);margin-top:2px">tech 88 · id 95 · src 74 · com 39</div></div><div class="card"><div class="label">Filiales</div><div class="value" style="font-size:15px">2</div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Cockpit décision — l&#x27;essentiel en 30 secondes</h3><div class="card" style="padding:14px;margin-bottom:14px"><ol style="margin:0;padding-left:18px;font-size:14px;line-height:1.6"><li style="font-weight:600">Entrer par l’entité Digital : IT autonome, budget propre, dette applicative mesurée.</li><li style="font-weight:400">Deux ESN déjà en place — viser le rang 2 sur un lot isolé.</li><li style="font-weight:400">Fenêtre courte : arbitrage du socle 2027 au quatrième trimestre.</li></ol></div><p style="margin:0 0 14px;font-size:14px"><span class="badge PUBLIC">▶ Action immédiate</span> Demander un atelier de cadrage TMA<span style="color:var(--muted)"> · Directeur des études, Entité Digital</span></p><div style="margin-bottom:14px"><div class="label" style="margin-bottom:6px">Périmètres prioritaires — le plan attaque ces zones, pas “le groupe” (/20)</div><div style="display:flex;flex-wrap:wrap;gap:8px"><span class="badge P1" title="IT autonome, budget propre">Entité Digital SAS · P1 · Directeur des études</span><span class="badge P2" title="Arbitrage socle">Groupe Exemple · P2</span></div></div><div><div class="label" style="margin-bottom:6px">Top 2 offres — périmètre · signal · offre · contact · angle · action · preuve · risque (§5)</div><div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr))"><div class="card" style="padding:14px"><div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:8px"><strong>Entité Digital SAS</strong><span style="display:flex;gap:6px"><span class="badge PRUDENT" title="contact d’entrée déduit du titre">action recadrée</span><span class="badge P1">P1</span></span></div><div class="kv" style="font-size:13px"><div style="display:contents"><span class="k">Signal</span><span>Douze offres TMA ouvertes</span></div><div style="display:contents"><span class="k">Offre</span><span>Équipe TMA 4 personnes</span></div><div style="display:contents"><span class="k">Contact</span><span>Julien Marchand · TECHNICAL</span></div><div style="display:contents"><span class="k">Angle</span><span>Reprise progressive du run</span></div><div style="display:contents"><span class="k">1re action</span><span>Atelier de cadrage 2 h</span></div><div style="display:contents"><span class="k">Preuve</span><span>PUBLIC</span></div><div style="display:contents"><span class="k">Risque</span><span>Contrat cadre concurrent</span></div><div style="display:contents"><span class="k">Message prêt (M1)</span><span>Bonjour, vos douze offres TMA ouvertes…</span></div></div></div><div class="card" style="padding:14px"><div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:8px"><strong>Groupe Exemple</strong><span style="display:flex;gap:6px"><span class="badge P2">P2</span></span></div><div class="kv" style="font-size:13px"><div style="display:contents"><span class="k">Signal</span><span>Arbitrage socle 2027</span></div><div style="display:contents"><span class="k">Offre</span><span>Audit de socle</span></div><div style="display:contents"><span class="k">Contact</span><span>—</span></div><div style="display:contents"><span class="k">Angle</span><span>Top-down</span></div><div style="display:contents"><span class="k">1re action</span><span>Note de cadrage</span></div><div style="display:contents"><span class="k">Preuve</span><span>HYPOTHESE</span></div><div style="display:contents"><span class="k">Risque</span><span>Cycle long</span></div></div></div></div></div><p style="margin:14px 0 0;font-size:12px;color:var(--muted)"><span class="badge HYPOTHESE">à vérifier (règle 70%)</span> budget socle 2027 · périmètre exact du contrat cadre · date de renouvellement</p></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Logique Axians — positionnement complément</h3><p style="font-size:13px;margin:0"><span class="badge PUBLIC">complément</span> Notre ESN appartient au groupe Groupe Exemple (rattachement : Entité Digital SAS). Positionnement complément, pas concurrence frontale.</p></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Logique de sélection — axes écartés (pourquoi, et comment les réactiver)</h3><div style="display:grid;gap:10px"><div class="card" style="padding:12px"><strong>Infogérance poste de travail</strong><div style="font-size:13px;margin-top:4px">Contrat cadre signé jusqu’en 2028</div><div style="font-size:12px;color:var(--muted);margin-top:4px">→ réactiver : Revenir six mois avant l’échéance</div></div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Vocabulaire du groupe — grille de lecture (2)</h3><table><thead><tr><th>Terme</th><th>Type</th><th>Sens</th><th>Pourquoi (commercial)</th></tr></thead><tbody><tr><td><strong>socle</strong></td><td><span class="badge">interne</span></td><td style="font-size:12px">Ensemble des briques techniques mutualisées</td><td style="font-size:12px">Le mot d’entrée des arbitrages budgétaires</td></tr><tr><td><strong>PLM</strong></td><td><span class="badge">metier</span></td><td style="font-size:12px">—</td><td style="font-size:12px">—</td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Audit par phase — d&#x27;où viennent le coût, le temps et les infos</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><div class="card"><div class="label" style="margin-bottom:10px">Durée par phase</div><div style="display:grid;gap:8px"><p style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0">Graphique en barres, 4 valeurs : research 74s, contacts 39s, classify 21s, plan 52s</p><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">research</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:100%;height:100%;background:#7c6cf6;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">74s</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">contacts</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:52.702702702702695%;height:100%;background:#34d399;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">39s</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">classify</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:28.37837837837838%;height:100%;background:#fbbf24;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">21s</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">plan</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:70.27027027027027%;height:100%;background:#f87171;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">52s</span></div></div></div><div class="card"><div class="label" style="margin-bottom:10px">Coût par phase</div><div style="display:grid;gap:8px"><p style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0">Graphique en barres, 4 valeurs : research $0.1840, contacts $0.0610, classify $0.0420, plan $0.1130</p><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">research</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:18.4%;height:100%;background:#7c6cf6;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">$0.1840</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">contacts</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:6.1%;height:100%;background:#34d399;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">$0.0610</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">classify</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:4.2%;height:100%;background:#fbbf24;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">$0.0420</span></div><div style="display:grid;grid-template-columns:140px 1fr 64px;align-items:center;gap:10px"><span style="font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis">plan</span><div style="background:var(--bg);border-radius:6px;overflow:hidden;height:22px"><div style="width:11.3%;height:100%;background:#f87171;border-radius:6px;min-width:2px"></div></div><span style="font-size:13px;text-align:right;font-variant-numeric:tabular-nums">$0.1130</span></div></div></div></div><table style="margin-top:12px"><thead><tr><th>Phase</th><th class="num">Coût</th><th class="num">Durée</th><th class="num">Tokens in / out</th><th>Sources</th></tr></thead><tbody><tr><td>research</td><td class="num">$0.1840</td><td class="num">74s</td><td class="num">41 200 / 6 100</td><td style="color:var(--muted);font-size:12px">2/3 OK</td></tr><tr><td>contacts</td><td class="num">$0.0610</td><td class="num">39s</td><td class="num">12 400 / 2 100</td><td style="color:var(--muted);font-size:12px">1/1 OK</td></tr><tr><td>classify</td><td class="num">$0.0420</td><td class="num">21s</td><td class="num">9 800 / 1 400</td><td style="color:var(--muted);font-size:12px">apollo:ok · pappers:degraded</td></tr><tr><td>plan</td><td class="num">$0.1130</td><td class="num">52s</td><td class="num">18 700 / 5 200</td><td style="color:var(--muted);font-size:12px">—</td></tr></tbody></table></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Déroulement — APIs appelées par phase</h3><div style="display:grid;gap:14px"><div><div style="font-weight:600;margin-bottom:6px">research</div><table><tbody><tr><td class="mono" style="width:220px">brave.search</td><td style="width:90px"><span class="badge" style="color:var(--accent)">ok</span></td><td style="color:var(--muted)">32 résultats</td></tr><tr><td class="mono" style="width:220px">firecrawl.scrape</td><td style="width:90px"><span class="badge" style="color:var(--muted)">degraded</span></td><td style="color:var(--muted)">2 pages sur 14 en échec</td></tr><tr><td class="mono" style="width:220px">pappers.company</td><td style="width:90px"><span class="badge" style="color:var(--accent)">ok</span></td><td style="color:var(--muted)">fiche complète</td></tr></tbody></table></div><div><div style="font-weight:600;margin-bottom:6px">contacts</div><table><tbody><tr><td class="mono" style="width:220px">apollo.search</td><td style="width:90px"><span class="badge" style="color:var(--accent)">ok</span></td><td style="color:var(--muted)">3 contacts</td></tr></tbody></table></div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Organigramme du groupe (3 entités)</h3><p style="margin:0 0 10px;font-size:13px;color:var(--muted)">Le groupe pilote ses entités par domaine ; la DSI groupe arbitre les socles, les entités gardent leurs projets métier.</p><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><span style="font-weight:400">Groupe Exemple</span><span style="color:var(--muted);font-size:12px"> · holding</span><span class="badge P2" style="margin-left:6px">P2</span><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><span style="font-weight:600">🎯 Entité Digital SAS</span><span style="color:var(--muted);font-size:12px"> · filiale</span><span class="badge P1" style="margin-left:6px">P1</span></li><li style="margin:4px 0"><span style="font-weight:400">Entité Systèmes SAS</span><span style="color:var(--muted);font-size:12px"> · filiale</span><span class="badge P3" style="margin-left:6px">P3</span></li></ul></li></ul><p style="margin:10px 0 0;font-size:12px;color:var(--muted)">🎯 = entité IT/digitale (cible n°1 ESN) · P1 attaque immédiate · P2 second temps · P3 longue traîne</p></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Organigramme des contacts (3)</h3><p style="margin:0 0 12px;font-size:12px;color:var(--muted)">Hiérarchie inférée des intitulés de poste (Apollo ne fournit pas les liens managériaux) — Direction → Management → Opérationnel, par entité.</p><div style="display:grid;gap:16px"><div><h4 style="margin:0 0 6px;font-size:13px;border-left:3px solid var(--border);padding-left:8px">Entité Digital SAS <span style="color:var(--muted);font-weight:400">· 1</span></h4><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">C-Level / COMEX (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Direction (1)</div><div style="display:flex;align-items:center;gap:6px;margin:3px 0;flex-wrap:wrap"><img src="https://exemple.test/photo1.jpg" alt="Julien Marchand" style="width:24px;height:24px;border-radius:50%;flex-shrink:0;border:1px solid var(--border);object-fit:cover" referrerPolicy="no-referrer"/><span>Julien Marchand</span><span style="color:var(--muted);font-size:12px">· Directeur des études</span><span class="badge TECHNICAL">TECHNICAL</span></div></li></ul></li></ul></div><div><h4 style="margin:0 0 6px;font-size:13px;border-left:3px solid var(--border);padding-left:8px">Groupe Exemple <span style="color:var(--muted);font-weight:400">· 1</span></h4><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">C-Level / COMEX (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Direction (1)</div><div style="display:flex;align-items:center;gap:6px;margin:3px 0;flex-wrap:wrap"><span style="width:24px;height:24px;border-radius:50%;flex-shrink:0;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:var(--surface);color:var(--muted);font-size:13px;font-weight:600">IR</span><span>Inès Rahmani</span><span style="color:var(--muted);font-size:12px">· DSI groupe</span><span class="badge ECONOMIC">ECONOMIC</span></div></li></ul></li></ul></div><div><h4 style="margin:0 0 6px;font-size:13px;border-left:3px solid var(--border);padding-left:8px">Entité non précisée <span style="color:var(--muted);font-weight:400">· 1</span></h4><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">C-Level / COMEX (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Direction (0)</div><ul style="margin:0;list-style:none;padding-left:14px;border-left:1px solid var(--border)"><li style="margin:4px 0"><div style="color:var(--muted);font-size:12px;font-weight:600">Management (1)</div><div style="display:flex;align-items:center;gap:6px;margin:3px 0;flex-wrap:wrap"><span style="width:24px;height:24px;border-radius:50%;flex-shrink:0;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;background:var(--surface);color:var(--muted);font-size:13px;font-weight:600">SV</span><span>Sophie Vasseur</span><span style="color:var(--muted);font-size:12px">· Responsable achats IT</span></div></li></ul></li></ul></li></ul></div></div></section><section style="margin-top:24px"><h3 style="font-size:14px;margin:0 0 10px">Contacts (3) — par entité</h3><p style="font-size:12px;margin:0 0 12px"><span style="color:var(--accent);font-weight:600">✓ décideur IT présent</span><span style="color:var(--muted)"> · 3 entité(s) · regroupés pour l’organigramme, triés par priorité</span></p