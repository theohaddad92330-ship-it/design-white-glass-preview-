# @bellum/mcp — remote MCP server (OAuth 2.1 Resource Server + tool proxy).
# Holds NO database credentials and NO OAuth signing key: it only advertises
# discovery metadata and forwards the user's token to the Bellum API.

# Port the MCP server binds to (Railway injects PORT).
PORT=3010

# Public URL of THIS MCP server — the OAuth `resource` identifier advertised in
# protected-resource metadata. Must match the API's MCP_PUBLIC_URL.
MCP_PUBLIC_URL=http://localhost:3010

# Public URL of the Bellum API = the OAuth authorization server advertised to
# MCP clients.
API_PUBLIC_URL=http://localhost:3000

# Internal URL used server-to-server to reach the API (token introspection +
# tool proxying). On Railway = internal DNS; locally = the API URL.
API_INTERNAL_URL=http://localhost:3000

# Shared secret to authenticate calls to the API's internal /oauth/introspect
# (sent as x-internal-secret). Same value the API validates.
INTERNAL_API_SECRET=dev-internal-secret-change-me
