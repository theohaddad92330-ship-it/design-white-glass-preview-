NEXT_PUBLIC_APP_URL=https://app.bellum-ai.com
NEXT_PUBLIC_SITE_URL=https://bellum-ai.com

# Server-only (no NEXT_PUBLIC_ prefix). Upstream for the /status page proxy
# (src/app/api/status/route.ts → GET <API_URL>/status). Defaults to the prod API.
API_URL=https://api.bellum-ai.com

# Server-only. Powers the /demo, /beta and /webinar form submissions (email via Resend).
# Without it, /api/demo, /api/beta and /api/webinar return an error and the forms show a clear message.
# NEVER expose this key to the client (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=
# Optional "From" overrides for the transactional emails (must be a Resend-verified sender).
# BETA_FROM_EMAIL falls back to DEMO_FROM_EMAIL, then to onboarding@resend.dev.
# WEBINAR_FROM_EMAIL falls back to BETA_FROM_EMAIL, then DEMO_FROM_EMAIL, then onboarding@resend.dev.
DEMO_FROM_EMAIL=
BETA_FROM_EMAIL=
WEBINAR_FROM_EMAIL=

# Sentry (projet bellum-website, UE). Vide = aucun envoi (dev/CI silencieux).
NEXT_PUBLIC_SENTRY_DSN=
