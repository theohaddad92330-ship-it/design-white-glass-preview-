# =============================================================================
# Rate limiting (ENG-57)
# =============================================================================
# Redis URL — shared by BullMQ (apps/api) and the ThrottlerStorage so counters
# survive across Railway replicas. Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6379

# Per-provider outbound throttle (apps/ia). Each provider has a sliding-window
# rate limit (requests per minute) plus a max-concurrent in-flight cap. The
# limiter is local to each Python process — multiple uvicorn workers will
# multiply the effective throughput by N.
CLAUDE_RPM=50
CLAUDE_CONCURRENCY=10

BRAVE_RPM=60
BRAVE_CONCURRENCY=5

APOLLO_RPM=60
APOLLO_CONCURRENCY=10

PAPPERS_RPM=600
PAPPERS_CONCURRENCY=20

FIRECRAWL_RPM=20
FIRECRAWL_CONCURRENCY=5

# =============================================================================
# Auth session cookies (cross-site logout fix)
# =============================================================================
# COOKIE_DOMAIN scopes EVERY auth cookie (session:{uid}, uploadsSig:{uid},
# loggedIn:{uid}, lastUsedLogin, bellum_did) to a parent domain so the SPA and
# the API on sibling subdomains share them.
#
# WHY IT MATTERS: when the API is on a different registrable domain than the SPA
# (e.g. *.up.railway.app vs app.bellum-ai.com), every request is cross-site and
# the JS-readable `loggedIn:` sentinel is written on the API's host — UNREADABLE
# by the SPA, which then logs the user out on every hard reload. The fix in prod
# is to put the API on a sibling subdomain (api.bellum-ai.com) AND set:
#   COOKIE_DOMAIN=.bellum-ai.com
# Leave EMPTY in local dev (host-only cookies; no Domain= attribute emitted).
# COOKIE_DOMAIN=.bellum-ai.com

# =============================================================================
# Analysis pipeline (ENG-65)
# =============================================================================
# Top-N contacts to enrich with Apollo People Match emails/phones in Phase 3.
# Each enriched contact costs ~6 Apollo credits (1 email + 5 phone) so this is
# a hard cap to bound spend.
APOLLO_ENRICH_LIMIT=10

# =============================================================================
# Contact enrichment fallback — Dropcontact (apps/api, optional)
# =============================================================================
# RGPD-safe enrichment (algorithmic — no stored pre-scraped database). Wired as
# an ADDITIVE fallback behind Apollo on the on-demand "Enrich" action: Apollo
# stays the default/sole provider. Unset → strict no-op (never called, zero
# network, Apollo unchanged). Set → when Apollo resolves nothing, the API submits
# a Dropcontact batch (POST /v1/enrich/all, header X-Access-Token) and polls the
# result to fill the pro email + job title. 1 enrichment credit per success
# (same as Apollo); no match ⇒ nothing persisted, no credit charged. A resolved
# contact is stamped source='dropcontact'.
# DROPCONTACT_API_KEY=

# =============================================================================
# MCP — connect Bellum to a sales rep's AI assistant (Claude Desktop, Cursor…)
# =============================================================================
# The whole feature is env-gated on MCP_PUBLIC_URL: unset = no-op (the API's
# /oauth/* endpoints refuse and the /settings/mcp screen shows "bientôt
# disponible"). apps/api acts as the OAuth 2.1 Authorization Server; apps/mcp is
# the Resource Server + tool proxy.
#
# API side:
#   API_PUBLIC_URL   — public URL of the API; OAuth issuer + token `iss`/`aud=api`
#                      (e.g. https://api.bellum-ai.com; default http://localhost:3000)
#   MCP_PUBLIC_URL   — public URL of the MCP server; OAuth `resource`/audience
#                      (e.g. https://mcp.bellum-ai.com). REQUIRED to enable.
#   MCP_OAUTH_SIGNING_KEY — HS256 key for access tokens; falls back to
#                      INTERNAL_API_SECRET when unset.
API_PUBLIC_URL=http://localhost:3000
# MCP_PUBLIC_URL=https://mcp.bellum-ai.com
# MCP_OAUTH_SIGNING_KEY=change-me-32-chars-minimum-secret
#
# apps/mcp service (see apps/mcp/.env.example):
#   PORT, MCP_PUBLIC_URL, API_PUBLIC_URL, API_INTERNAL_URL, INTERNAL_API_SECRET
#
# Web (apps/web):
#   VITE_MCP_URL — the MCP server URL shown on /settings/mcp (unset = "bientôt").
# VITE_MCP_URL=https://mcp.bellum-ai.com
