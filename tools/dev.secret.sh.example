# Website / public URLs
export NEXT_PUBLIC_APP_URL="http://localhost:5173"
export NEXT_PUBLIC_SITE_URL="http://localhost:3004"

# SMTP (Mailpit local)
export SMTP_HOST="localhost"
export SMTP_PORT="1025"
