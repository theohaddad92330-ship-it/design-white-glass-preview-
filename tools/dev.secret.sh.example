#!/bin/bash
# ============================================================
# Local secrets — NEVER COMMIT THIS FILE
#
# Copy this file:
#   cp tools/dev.secret.sh.example tools/dev.secret.sh
#
# Fill in your real keys, then run:
#   pnpm dev
# ============================================================

# --- Remote Supabase (cloud) ---
# export SUPABASE_URL=""
# export SUPABASE_ANON_KEY=""
# export SUPABASE_SERVICE_ROLE_KEY=""
# export SUPABASE_JWT_SECRET=""
# export SUPABASE_PROJECT_ID=""

# --- Local Supabase (Docker) ---
export POSTGRES_PASSWORD="postgres"
export POSTGRES_USER="postgres"
export POSTGRES_HOST="localhost"
export POSTGRES_PORT="5432"
export POSTGRES_DB="postgres"
export SUPABASE_URL="http://localhost:54321"
export SUPABASE_ANON_KEY=""              # generate with JWT_SECRET + role=anon
export SUPABASE_SERVICE_ROLE_KEY=""      # generate with JWT_SECRET + role=service_role
export SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
export SUPABASE_PROJECT_ID="bellum-local"
export MIGRATION_DIR="infra/supabase/migrations"

# Google OAuth (for local Supabase Auth)
export GOOGLE_AUTH_ENABLED="false"
export GOOGLE_CLIENT_ID=""
export GOOGLE_CLIENT_SECRET=""

# Claude
export ANTHROPIC_API_KEY=""

# External APIs
export BRAVE_API_KEY=""
export FIRECRAWL_API_KEY=""
export APOLLO_API_KEY=""
export PAPPERS_API_KEY=""

# Stripe
export STRIPE_SECRET_KEY=""
export STRIPE_WEBHOOK_SECRET=""

# Infra (local Docker)
export REDIS_URL="redis://localhost:6379"

# App
export IA_SERVICE_URL="http://127.0.0.1:8000"
export API_INTERNAL_URL="http://localhost:3000"
export FRONTEND_URL="http://localhost:5173"
export PORT="3000"
export NODE_ENV="development"
export INTERNAL_API_SECRET="dev-secret-change-me"
export DASHBOARD_OPERATOR_USER_ID=""
export JWT_ACCESS_AUDIENCE="bellum-api"
export JWT_REFRESH_AUDIENCE="bellum-refresh"

# Web app (Vite)
export VITE_API_URL="http://localhost:3000"
export VITE_MARKETING_URL="http://localhost:3004"
export VITE_SUPABASE_URL="http://localhost:54321"
export VITE_SUPABASE_ANON_KEY=""
