{
  "name": "@bellum/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./geo-communes": {
      "types": "./src/schemas/geo-communes.ts",
      "import": "./dist/schemas/geo-communes.js",
      "require": "./dist/schemas/geo-communes.js"
    },
    "./geo-coordinates": {
      "types": "./src/schemas/geo-communes-coordinates.ts",
      "import": "./dist/schemas/geo-communes-coordinates.js",
      "require": "./dist/schemas/geo-communes-coordinates.js"
    }
  },
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "geo-communes": [
        "src/schemas/geo-communes.ts"
      ],
      "geo-coordinates": [
        "src/schemas/geo-communes-coordinates.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "check-types": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@bellum/tooling": "workspace:^",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
