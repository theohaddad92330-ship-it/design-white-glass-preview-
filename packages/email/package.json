{
  "name": "@bellum/email",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./templates/*": {
      "types": "./src/templates/*.tsx",
      "import": "./src/templates/*.tsx"
    }
  },
  "scripts": {
    "dev": "email dev --dir src/templates --port 3010",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react-email": "^5.0.0",
    "typescript": "^5.8.3"
  }
}
